{
  "expo": {
    "name": "RefynHome",
    "slug": "RefynHome",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563EB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masood979899.RefynHome",
      "config": {
        "googleMapsApiKey": "AIzaSyDKE8TyUf0gDUZFK0S-Cc1HgYms-VAdoAE"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RefynHome needs your location to show nearby service vendors and provide accurate arrival times.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need your location to provide real-time service tracking even when the app is in the background.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#2563EB"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.masood979899.RefynHome",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDKE8TyUf0gDUZFK0S-Cc1HgYms-VAdoAE"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Refyn Home to track your location while you're en route to customers.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#FF0000"
        }
      ],
      "expo-font",
      "expo-image-picker",
      "expo-secure-store"
    ],
    "notification": {
      "icon": "./assets/adaptive-icon.png",
      "color": "#FF0000"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a3ee123-d1a2-450e-abec-70c92c577477"
      }
    },
    "owner": "masood979899"
  }
}
