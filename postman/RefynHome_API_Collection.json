            "url": {
              "raw": "{{base_url}}/core/service-requests/{{service_request_id}}/nearby-vendors/",
              "host": ["{{base_url}}"],
              "path": ["core", "service-requests", "{{service_request_id}}", "nearby-vendors", ""]
            }
          }
        },
        {
          "name": "Create Proposal (Vendor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vendor_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"service_request\": 1,\n    \"price\": 2500,\n    \"estimated_duration\": \"2 hours\",\n    \"message\": \"I can fix your AC today. I have 5 years experience in AC repair.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/core/vendors/proposals/",
              "host": ["{{base_url}}"],
              "path": ["core", "vendors", "proposals", ""]
            }
          }
        }
      ]
    }
  ]
}
